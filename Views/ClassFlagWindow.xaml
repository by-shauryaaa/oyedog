<Window x:Class="PixelDogReminders.Views.ClassFlagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Reminder Flag"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Pixel Flag Banner -->
        <Border x:Name="FlagBorder"
                Background="#64B5F6"
                BorderBrush="#2D1E14"
                BorderThickness="3"
                CornerRadius="4"
                Padding="16,10"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#2D1E14" Direction="315" ShadowDepth="4" BlurRadius="0" Opacity="0.8" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Flag Icon / Indicator -->
                <TextBlock Text="🚩" 
                           FontSize="14" 
                           Margin="0,0,10,0" 
                           VerticalAlignment="Center" />

                <!-- Countdown Badge -->
                <Border x:Name="CountdownBadge"
                        Background="#2D1E14"
                        CornerRadius="3"
                        Padding="6,4"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCountdown"
                               Text="in 10 min"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="9"
                               Foreground="#FFD700"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Subject Name -->
                <TextBlock x:Name="TxtSubjectName"
                           Text="Data Structures"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#2D1E14"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
