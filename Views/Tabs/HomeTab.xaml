<UserControl x:Class="PixelDogReminders.Views.Tabs.HomeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="680">

    <UserControl.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Background" Value="#FFF8E7" />
            <Setter Property="BorderBrush" Value="#8D6E57" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PixelActionBtn" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Dynamic Greeting -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#D0C4B8"
                BorderThickness="2"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TxtGreeting"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="12"
                           Foreground="#8B0000"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Good morning, Abhishek" />

                <TextBlock x:Name="TxtSubGreeting"
                           FontSize="11"
                           Foreground="#665544"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="Your desktop companion is ready for today." />
            </StackPanel>
        </Border>

        <!-- 2. Live Real-Time Digital Clock -->
        <Border Grid.Row="1"
                Background="#3D271D"
                BorderBrush="#8D6E57"
                BorderThickness="2"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏰ " FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtLiveClock"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="12"
                           Foreground="#FFD700"
                           VerticalAlignment="Center"
                           Text="12:00:00 PM" />
            </StackPanel>
        </Border>

        <!-- 3. Permanent Dog Mascot Display (Clickable for Screen Walk) & Pet Buttons -->
        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Speech / Reaction Bubble above dog -->
                <Border x:Name="PnlDogSpeech"
                        Background="#FFFBF0"
                        BorderBrush="#8D6E57"
                        BorderThickness="2"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Center"
                        MaxWidth="340">
                    <TextBlock x:Name="TxtDogReaction"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="8"
                               Foreground="#8B5A2B"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Tap me to walk across your screen! 🐾" />
                </Border>

                <!-- Dog Sprite Box (Click to Walk) -->
                <Grid Cursor="Hand"
                      MouseLeftButtonUp="DogSprite_MouseLeftButtonUp"
                      ToolTip="Click your dog companion to make it walk across your screen!">
                    
                    <!-- Soft Drop Shadow beneath dog -->
                    <Ellipse Width="150" Height="24"
                             Fill="#35000000"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,8">
                        <Ellipse.Effect>
                            <BlurEffect Radius="14" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Animated Dog Sprite -->
                    <Image x:Name="ImgHomeDog"
                           Width="170"
                           Height="170"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>

                <!-- Interactive Pet Care Buttons: Feed, Pet, Walk -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="BtnFeedDog"
                            Content="🍖 Feed Dog"
                            Style="{StaticResource PixelActionBtn}"
                            Background="#FFF0D4"
                            Click="BtnFeedDog_Click" />

                    <Button x:Name="BtnPetDog"
                            Content="❤️ Pet / Play"
                            Style="{StaticResource PixelActionBtn}"
                            Background="#FFE6E8"
                            Click="BtnPetDog_Click" />

                    <Button x:Name="BtnWalkDog"
                            Content="🚶 Walk Screen"
                            Style="{StaticResource PixelActionBtn}"
                            Background="#E6F4EA"
                            Click="BtnWalkDog_Click" />
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- 4. Quick Companion Status at bottom -->
        <Border Grid.Row="3"
                Background="#FAF2E8"
                BorderBrush="#E0D6CC"
                BorderThickness="2"
                CornerRadius="4"
                Padding="12,10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="● Running Resident in System Tray"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#3D271D" />
                    <TextBlock Text="Launches automatically on laptop startup. Reminders &amp; match alerts continue in background."
                               FontSize="11"
                               Foreground="#776655"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Test Popup 🐶"
                        Style="{StaticResource PixelButtonStyle}"
                        Background="#FFF8E7"
                        Click="BtnTestPopup_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
