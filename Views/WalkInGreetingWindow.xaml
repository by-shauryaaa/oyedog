<Window x:Class="PixelDogReminders.Views.WalkInGreetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixel Dog Walk-In Greeting"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <!-- Pixel Button Style -->
        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FFF8E7"
                                BorderBrush="#2D1E14"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE4A0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E09040" />
                                <Setter TargetName="border" Property="Margin" Value="0,2,0,-2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Speech Bubble Style -->
        <Style x:Key="SpeechBubbleStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFBF0" />
            <Setter Property="BorderBrush" Value="#2D1E14" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="4" Direction="315" Color="#35000000" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" Width="300">

            <!-- 1. Speech Bubble (Hidden while walking, fades in on arrival) -->
            <StackPanel x:Name="PnlSpeechBubble" HorizontalAlignment="Center" Margin="0,0,0,2" Opacity="0">
                <Border Style="{StaticResource SpeechBubbleStyle}" HorizontalAlignment="Center" MaxWidth="280">
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="8"
                                   Foreground="#9E5B23"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6"
                                   Text="GOOD MORNING" />

                        <TextBlock x:Name="TxtGreeting"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="11"
                                   Foreground="#2D1E14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="16"
                                   Text="Good morning, Abhishek" />
                    </StackPanel>
                </Border>

                <!-- Speech Bubble Tail pointing down to dog -->
                <Polygon Points="0,0 8,10 16,0"
                         Fill="#FFFBF0"
                         Stroke="#2D1E14"
                         StrokeThickness="3"
                         HorizontalAlignment="Center"
                         Margin="0,-2,0,0" />
            </StackPanel>

            <!-- 2. Dog Sprite + Shadow -->
            <Grid HorizontalAlignment="Center" Width="200" Height="180" Margin="0,-4,0,4">
                <!-- Drop Shadow -->
                <Ellipse Width="140" Height="24"
                         Fill="#70000000"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,6">
                    <Ellipse.Effect>
                        <BlurEffect Radius="14" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Dog Sprite -->
                <Image x:Name="ImgDogSprite"
                       Width="170"
                       Height="170"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>

            <!-- 3. Pet Interaction Buttons (Hidden while walking) -->
            <StackPanel x:Name="PnlButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0">
                <Button x:Name="BtnFeed"
                        Content="🍖 Feed"
                        Style="{StaticResource PixelButtonStyle}"
                        Background="#FFF0D4"
                        Click="BtnFeed_Click" />

                <Button x:Name="BtnLetItBe"
                        Content="🐾 Let it be"
                        Style="{StaticResource PixelButtonStyle}"
                        Background="#E8F4EC"
                        Click="BtnLetItBe_Click" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
