<UserControl x:Class="PixelDogReminders.Views.Tabs.ScheduleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FFD700"
                                BorderBrush="#2D1E14"
                                BorderThickness="2"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE44D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C69500" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6">
            <!-- Empty State -->
            <Border x:Name="PnlEmptyState"
                    Background="#FAF7F2"
                    BorderBrush="#2D1E14"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="32,24"
                    Margin="0,16"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="NO CLASSES SCHEDULED"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#2D1E14"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Add your subjects and weekly slots to get class alerts."
                               FontSize="13"
                               Foreground="#665544"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                    <Button Content="+ ADD YOUR FIRST SUBJECT"
                            Style="{StaticResource PixelButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="BtnAddFirstSubject_Click" />
                </StackPanel>
            </Border>

            <!-- Grouped Schedule Container -->
            <StackPanel x:Name="PnlScheduleGroups" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
