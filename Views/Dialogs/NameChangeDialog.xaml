<Window x:Class="PixelDogReminders.Views.Dialogs.NameChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Display Name"
        Width="440"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF7F2"
        BorderBrush="#8D6E57"
        BorderThickness="3"
        WindowStyle="None">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Background" Value="#FFF8E7" />
            <Setter Property="BorderBrush" Value="#8D6E57" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#3D271D"
                Padding="12,10"
                CornerRadius="4"
                Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="✨ CUSTOM COMPANION NAME ✨"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="9"
                           Foreground="#FFD700"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Secret unlocked! Set your custom display name."
                           FontSize="10"
                           Foreground="#D8C5B2"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Input Body -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="YOUR DISPLAY NAME:"
                       FontFamily="{StaticResource PixelFont}"
                       FontSize="8"
                       Foreground="#8D6E57"
                       Margin="0,0,0,6" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtDisplayName"
                         Grid.Column="0"
                         Height="36"
                         FontFamily="{StaticResource PixelFont}"
                         FontSize="10"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         Background="#FFFFFF"
                         BorderBrush="#8D6E57"
                         BorderThickness="2"
                         MaxLength="30"
                         Margin="0,0,8,0" />

                <Button Grid.Column="1"
                        Content="Reset"
                        Style="{StaticResource PixelButtonStyle}"
                        Background="#F5EFE6"
                        ToolTip="Reset back to Abhishek"
                        Click="BtnReset_Click" />
            </Grid>

            <TextBlock x:Name="TxtValidationMsg"
                       Text=""
                       FontSize="11"
                       Foreground="#D32F2F"
                       Margin="0,6,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource PixelButtonStyle}"
                    Background="#EBE3D8"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click" />

            <Button Content="Save Name ✨"
                    Style="{StaticResource PixelButtonStyle}"
                    Background="#FFD700"
                    Foreground="#2D1E14"
                    Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
