<Window x:Class="PixelDogReminders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oye Dog — Abhishek's Companion"
        Width="820"
        Height="640"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#FAF7F2"
        Icon="pack://application:,,,/Assets/Sprites/idle_0.png">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <!-- Sidebar Collapse Toggle Button -->
        <Style x:Key="CollapseToggleButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="Background" Value="#2D1E14" />
            <Setter Property="BorderBrush" Value="#5A3E2B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5A3E2B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A100A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Nav Row Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#D8C5B2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder"
                                Background="#2A1B14"
                                BorderBrush="#5A3E2B"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="8,8">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#4D3325" />
                                <Setter TargetName="navBorder" Property="BorderBrush" Value="#8D6E57" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="navBorder" Property="Background" Value="#FFD700" />
                                <Setter TargetName="navBorder" Property="BorderBrush" Value="#2D1E14" />
                                <Setter Property="Foreground" Value="#2D1E14" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FAF7F2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. Left Vertical Sidebar -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Width="200"
                Background="#3D271D"
                BorderBrush="#5A3E2B"
                BorderThickness="0,0,3,0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header: Logo / Branding & Toggle Button -->
                <Grid Grid.Row="0" Margin="10,12,10,10">
                    <!-- Branding (Expanded only) -->
                    <StackPanel x:Name="PnlBranding"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Image Source="pack://application:,,,/Assets/Sprites/idle_0.png"
                               Width="24"
                               Height="24"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               VerticalAlignment="Center" />
                        <TextBlock Text="OYE DOG"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#FFD700"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Collapse / Expand Toggle Button -->
                    <Button x:Name="BtnToggleSidebar"
                            Content="◀"
                            Style="{StaticResource CollapseToggleButtonStyle}"
                            HorizontalAlignment="Right"
                            ToolTip="Collapse sidebar"
                            Click="BtnToggleSidebar_Click" />
                </Grid>

                <!-- Nav Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PnlNavList" Margin="8,4,8,4">
                        <!-- Home Icon (Visible only in collapsed mode) -->
                        <Button x:Name="BtnNavHomeCollapsed"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                ToolTip="🏠 Home Screen"
                                Visibility="Collapsed"
                                Click="BtnNavHome_Click">
                            <TextBlock Text="🏠" FontSize="14" HorizontalAlignment="Center" />
                        </Button>

                        <!-- Reminders -->
                        <Button x:Name="BtnNavReminders"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                ToolTip="🐶 Habit Reminders"
                                Click="BtnNavReminders_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🐶" FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0" />
                                <TextBlock x:Name="TxtLabelReminders" Text="Reminders" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Matches -->
                        <Button x:Name="BtnNavMatches"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                ToolTip="⚽ Barca &amp; F1 Matches"
                                Click="BtnNavMatches_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚽" FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0" />
                                <TextBlock x:Name="TxtLabelMatches" Text="Matches" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Timetable -->
                        <Button x:Name="BtnNavTimetable"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                ToolTip="📅 Timetable Schedule"
                                Click="BtnNavTimetable_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅" FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0" />
                                <TextBlock x:Name="TxtLabelTimetable" Text="Timetable" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button x:Name="BtnNavSettings"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                ToolTip="⚙️ Settings &amp; Configuration"
                                Click="BtnNavSettings_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0" />
                                <TextBlock x:Name="TxtLabelSettings" Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Area: Dog Companion Habitat (Expanded) / Tray Indicator (Collapsed) -->
                <Grid Grid.Row="2" Margin="4,8,4,16">
                    <!-- Dog Companion Stage (Expanded) -->
                    <Grid x:Name="PnlSidebarDogWidget"
                          Cursor="Hand"
                          ToolTip="Click Dogu to hang out at Home"
                          MouseLeftButtonUp="PnlSidebarDogWidget_MouseLeftButtonUp">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Floating Heart & Clock Badge -->
                            <Border x:Name="PnlDogBadge"
                                    Background="#2A1B14"
                                    BorderBrush="#5A3E2B"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,3"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♥ " Foreground="#FF6B8B" FontSize="8" />
                                    <TextBlock x:Name="SidebarClock"
                                               Text="12:00 PM"
                                               FontFamily="{StaticResource PixelFont}"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               Foreground="#FFD700" />
                                </StackPanel>
                            </Border>

                            <!-- Large Animated Dog Sprite & Grounding Shadow -->
                            <Grid HorizontalAlignment="Center">
                                <Ellipse x:Name="DogFloorShadow"
                                         Width="60"
                                         Height="14"
                                         Fill="#1E120A"
                                         VerticalAlignment="Bottom"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,2" />

                                <Image x:Name="SidebarDogSprite"
                                       Width="72"
                                       Height="72"
                                       Source="pack://application:,,,/Assets/Sprites/idle_0.png"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center" />
                            </Grid>

                            <!-- Companion Label -->
                            <TextBlock x:Name="TxtCompanionName"
                                       Text="DOGU"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="7"
                                       FontWeight="Bold"
                                       Foreground="#D8C5B2"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Collapsed Vertical Tray Chip -->
                    <Border x:Name="PnlSidebarTrayChip"
                            Background="#24160E"
                            BorderBrush="#5A3E2B"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="2,12"
                            HorizontalAlignment="Center"
                            ToolTip="Oye Dog is resident in system tray"
                            Visibility="Collapsed">
                        <TextBlock Text="● TRAY"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="7"
                                   Foreground="#9FE29D">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Main Content Area -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        Background="#FAF7F2"
                        Focusable="False" />
    </Grid>
</Window>
