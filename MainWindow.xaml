<Window x:Class="PixelDogReminders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oye Dog — Abhishek's Companion"
        Width="780"
        Height="640"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#FAF7F2"
        Icon="pack://application:,,,/Assets/Sprites/idle_0.png">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <!-- Tab Item Custom Style -->
        <Style x:Key="PixelTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#5A3E2B" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#EBE3D8"
                                BorderBrush="#C7B7A6"
                                BorderThickness="2,2,2,0"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FAF7F2" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8D6E57" />
                                <Setter Property="Foreground" Value="#2D1E14" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFF8E7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar with Responsive Columns -->
        <Border Grid.Row="0"
                Background="#3D271D"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Dog Mascot Thumbnail in Header -->
                <Image Source="pack://application:,,,/Assets/Sprites/idle_0.png"
                       Width="32"
                       Height="32"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="OYE DOG"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="11"
                               Foreground="#FFD700"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Your daily habit, sports, &amp; morning companion"
                               FontSize="11"
                               Foreground="#D8C5B2"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Status indicator -->
                <Border x:Name="PnlTrayBadge"
                        Grid.Column="2"
                        Background="#553A2B"
                        CornerRadius="3"
                        Padding="8,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="● System Tray Resident"
                               FontSize="10"
                               Foreground="#9FE29D" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Tab Control: Home | Reminders | Matches | Settings -->
        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Background="#FAF7F2"
                    BorderBrush="#8D6E57"
                    BorderThickness="0,2,0,0"
                    Margin="12,10,12,12">

            <!-- Tab 0: Home -->
            <TabItem Header="🏠 Home" Style="{StaticResource PixelTabItemStyle}" IsSelected="True">
                <ContentControl x:Name="HomeContent" />
            </TabItem>

            <!-- Tab 1: Reminders -->
            <TabItem Header="🐶 Reminders" Style="{StaticResource PixelTabItemStyle}">
                <ContentControl x:Name="RemindersContent" />
            </TabItem>

            <!-- Tab 2: Matches -->
            <TabItem Header="⚽🏎️ Matches" Style="{StaticResource PixelTabItemStyle}">
                <ContentControl x:Name="MatchesContent" />
            </TabItem>

            <!-- Tab 3: Timetable -->
            <TabItem Header="📅 Timetable" Style="{StaticResource PixelTabItemStyle}">
                <ContentControl x:Name="TimetableContent" />
            </TabItem>

            <!-- Tab 4: Settings -->
            <TabItem Header="⚙️ Settings" Style="{StaticResource PixelTabItemStyle}">
                <ContentControl x:Name="SettingsContent" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
