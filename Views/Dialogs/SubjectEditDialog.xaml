<Window x:Class="PixelDogReminders.Views.Dialogs.SubjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Subject"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <!-- Standard Button Style -->
        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FFF8E7"
                                BorderBrush="#2D1E14"
                                BorderThickness="2"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE8D6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0D6CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PixelPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FFD700"
                                BorderBrush="#2D1E14"
                                BorderThickness="2"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE44D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C69500" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="PixelDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
            <Setter Property="Foreground" Value="#8B0000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FFEBEE"
                                BorderBrush="#8B0000"
                                BorderThickness="2"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFCDD2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF9A9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Chip Style -->
        <Style x:Key="QuickChipStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="7" />
            <Setter Property="Foreground" Value="#665544" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#F5EFE6"
                                BorderBrush="#D0C4B8"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE8D6" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#8D6E57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="#FAF7F2"
                BorderBrush="#2D1E14"
                BorderThickness="3"
                CornerRadius="6"
                Padding="24"
                Width="500">
            <Border.Effect>
                <DropShadowEffect Color="#2D1E14" Direction="315" ShadowDepth="6" BlurRadius="0" Opacity="0.9" />
            </Border.Effect>

            <StackPanel>
                <!-- Dialog Title -->
                <TextBlock x:Name="TxtDialogTitle"
                           Text="📚 ADD SUBJECT"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#2D1E14"
                           Margin="0,0,0,18" />

                <!-- Subject Name & Color Row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="SUBJECT NAME"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="8"
                                   Foreground="#8D6E57"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="TxtSubjectName"
                                 Padding="10,8"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Background="#FFFFFF"
                                 BorderBrush="#2D1E14"
                                 BorderThickness="2" />
                    </StackPanel>

                    <!-- Assigned Color Swatch -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="COLOR"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="8"
                                   Foreground="#8D6E57"
                                   Margin="0,0,0,6"
                                   HorizontalAlignment="Center" />
                        <Border x:Name="ColorChip"
                                Width="36"
                                Height="36"
                                Background="#64B5F6"
                                BorderBrush="#2D1E14"
                                BorderThickness="2"
                                CornerRadius="4" />
                    </StackPanel>
                </Grid>

                <!-- Duration & Room Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Duration (Text field with presets) -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="DURATION (MINUTES)"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="8"
                                   Foreground="#8D6E57"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="TxtDuration"
                                 Text="60"
                                 Padding="8,6"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Background="#FFFFFF"
                                 BorderBrush="#2D1E14"
                                 BorderThickness="2"
                                 Margin="0,0,0,4"
                                 TextChanged="TxtDuration_TextChanged" />
                        <WrapPanel>
                            <Button Content="45m" Style="{StaticResource QuickChipStyle}" Click="BtnDurationPreset_Click" Tag="45" />
                            <Button Content="50m" Style="{StaticResource QuickChipStyle}" Click="BtnDurationPreset_Click" Tag="50" />
                            <Button Content="60m" Style="{StaticResource QuickChipStyle}" Click="BtnDurationPreset_Click" Tag="60" />
                            <Button Content="75m" Style="{StaticResource QuickChipStyle}" Click="BtnDurationPreset_Click" Tag="75" />
                            <Button Content="90m" Style="{StaticResource QuickChipStyle}" Click="BtnDurationPreset_Click" Tag="90" />
                            <Button Content="120m" Style="{StaticResource QuickChipStyle}" Click="BtnDurationPreset_Click" Tag="120" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Room -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="ROOM / HALL (OPTIONAL)"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="8"
                                   Foreground="#8D6E57"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="TxtRoom"
                                 Padding="8,6"
                                 FontSize="13"
                                 Background="#FFFFFF"
                                 BorderBrush="#2D1E14"
                                 BorderThickness="2" />
                    </StackPanel>
                </Grid>

                <!-- Recurring Slots Section -->
                <Border Background="#FFF8E7"
                        BorderBrush="#8D6E57"
                        BorderThickness="2"
                        CornerRadius="4"
                        Padding="14"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="RECURRING WEEKLY SLOTS"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="8"
                                       Foreground="#8D6E57"
                                       VerticalAlignment="Center" />
                            <Button Content="+ ADD SLOT"
                                    Style="{StaticResource PixelPrimaryButtonStyle}"
                                    Padding="12,8"
                                    FontSize="8"
                                    MinHeight="30"
                                    HorizontalAlignment="Right"
                                    Click="BtnAddSlot_Click" />
                        </Grid>

                        <!-- Empty State for Slots -->
                        <TextBlock x:Name="TxtNoSlots"
                                   Text="No slots added yet. Tap '+ Add Slot' above to schedule class times."
                                   FontSize="11"
                                   Foreground="#887766"
                                   FontStyle="Italic"
                                   Margin="4,8" />

                        <!-- Slots List -->
                        <ItemsControl x:Name="LstSlots">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E0D6CC"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🕒 " FontSize="12" />
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontFamily="{StaticResource PixelFont}"
                                                           FontSize="9"
                                                           Foreground="#2D1E14"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Delete Slot Button -->
                                            <Button Content="✕"
                                                    Foreground="#8B0000"
                                                    FontWeight="Bold"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Right"
                                                    Tag="{Binding Slot}"
                                                    Click="BtnDeleteSlot_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid>
                    <!-- Delete Subject Button (if editing) -->
                    <Button x:Name="BtnDeleteSubject"
                            Content="DELETE"
                            Style="{StaticResource PixelDangerButtonStyle}"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="BtnDeleteSubject_Click" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCEL"
                                Style="{StaticResource PixelButtonStyle}"
                                Click="BtnCancel_Click"
                                Margin="0,0,10,0" />
                        <Button Content="SAVE SUBJECT"
                                Style="{StaticResource PixelPrimaryButtonStyle}"
                                Click="BtnSave_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
