<Window x:Class="PixelDogReminders.Views.ClassFlagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Reminder Alert"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>
    </Window.Resources>

    <Grid Margin="0" ClipToBounds="False">
        <!-- 1. Simple Style (Classic Fly-by Flag) -->
        <Grid x:Name="SimpleContainer" Margin="12">
            <Border x:Name="FlagBorder"
                    Background="#64B5F6"
                    BorderBrush="#2D1E14"
                    BorderThickness="3"
                    CornerRadius="4"
                    Padding="16,10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#2D1E14" Direction="315" ShadowDepth="4" BlurRadius="0" Opacity="0.8" />
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚩" 
                               FontSize="14" 
                               Margin="0,0,10,0" 
                               VerticalAlignment="Center" />

                    <Border x:Name="CountdownBadge"
                            Background="#2D1E14"
                            CornerRadius="3"
                            Padding="6,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCountdown"
                                   Text="in 10 min"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="9"
                                   Foreground="#FFD700"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TxtSubjectName"
                               Text="Data Structures"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#2D1E14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Cloud Style (Floating Pixel Cloud) -->
        <Grid x:Name="CloudContainer" Visibility="Collapsed" Width="360" Height="120" Margin="12">
            <!-- Cloud Graphic Backdrop -->
            <Image Source="pack://application:,,,/Assets/Sprites/reminder_cloud.png"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Image.Effect>
                    <DropShadowEffect Color="#30000000" Direction="315" ShadowDepth="5" BlurRadius="4" />
                </Image.Effect>
            </Image>

            <!-- Text Content inside Cloud -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                <Border Background="#2D1E14"
                        CornerRadius="3"
                        Padding="6,3"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4">
                    <TextBlock x:Name="TxtCloudCountdown"
                               Text="in 10 min"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="8"
                               Foreground="#FFD700" />
                </Border>

                <TextBlock x:Name="TxtCloudSubject"
                           Text="Data Structures"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#2D1E14"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 3. Banner Style (Full-height Canvas for Continuous Falling to Screen Bottom Edge) -->
        <Canvas x:Name="BannerContainer" Visibility="Collapsed" Width="440" ClipToBounds="False">
            <!-- Top Threads (anchored at Y=0 of the screen) -->
            <Canvas x:Name="PnlTopThreads" Width="380" Canvas.Left="30" Canvas.Top="0" RenderTransformOrigin="0.5,0.0">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="ScaleTopThreads" ScaleY="1" />
                </Canvas.RenderTransform>
                <Border x:Name="LeftThreadTop" Width="3" Background="#3D271D" Canvas.Left="40" Canvas.Top="0" Height="200" />
                <Border x:Name="RightThreadTop" Width="3" Background="#3D271D" Canvas.Right="40" Canvas.Top="0" Height="200" />
            </Canvas>

            <!-- Billboard Plaque in Subject Color -->
            <Border x:Name="BillboardBorder"
                    Width="380"
                    Canvas.Left="30"
                    Canvas.Top="-150"
                    Background="#64B5F6"
                    BorderBrush="#2D1E14"
                    BorderThickness="3"
                    CornerRadius="4"
                    Padding="16,12"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#2D1E14" Direction="315" ShadowDepth="5" BlurRadius="0" Opacity="0.8" />
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Top Countdown Pill -->
                    <Border Background="#2D1E14"
                            CornerRadius="3"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔 " FontSize="9" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtBannerCountdown"
                                       Text="in 10 min"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FFD700"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Large Subject Name in Billboard -->
                    <TextBlock x:Name="TxtBannerSubject"
                               Text="Data Structures"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#2D1E14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Bottom Threads (anchored to bottom edge of screen for bottom position) -->
            <Canvas x:Name="PnlBottomThreads" Width="380" Canvas.Left="30" Visibility="Collapsed" RenderTransformOrigin="0.5,1.0">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="ScaleBottomThreads" ScaleY="1" />
                </Canvas.RenderTransform>
                <Border x:Name="LeftThreadBottom" Width="3" Background="#3D271D" Canvas.Left="40" Canvas.Top="0" Height="200" />
                <Border x:Name="RightThreadBottom" Width="3" Background="#3D271D" Canvas.Right="40" Canvas.Top="0" Height="200" />
            </Canvas>
        </Canvas>
    </Grid>
</Window>
