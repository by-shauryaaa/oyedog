<UserControl x:Class="PixelDogReminders.Views.Tabs.RemindersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="680">

    <UserControl.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Background" Value="#FFF8E7" />
            <Setter Property="BorderBrush" Value="#8D6E57" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Add Button -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="DAILY HABIT REMINDERS"
                       FontFamily="{StaticResource PixelFont}"
                       FontSize="11"
                       Foreground="#3D271D"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <Button Content="+ Add Custom Reminder"
                    Style="{StaticResource PixelButtonStyle}"
                    HorizontalAlignment="Right"
                    Background="#E6F4EA"
                    Click="BtnAddReminder_Click" />
        </Grid>

        <!-- 2. Reminders List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <ItemsControl x:Name="ItemsReminders">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF"
                                BorderBrush="#E0D6CC"
                                BorderThickness="2"
                                CornerRadius="4"
                                Margin="0,0,0,8"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Sprite Thumbnail -->
                                <Border Background="#FFF8E7"
                                        BorderBrush="#8D6E57"
                                        BorderThickness="2"
                                        Width="56"
                                        Height="56"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding VariantPreviewPath}"
                                           Width="48"
                                           Height="48"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>

                                <!-- Reminder Info -->
                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#2D1E14"
                                                   TextWrapping="Wrap" />
                                        <Border Background="#F0EBE1"
                                                CornerRadius="2"
                                                Padding="6,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                MaxWidth="200">
                                            <TextBlock Text="{Binding SummaryText}"
                                                       FontSize="11"
                                                       Foreground="#7A5C45"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- Message in Speech Bubble Look -->
                                    <TextBlock Text="{Binding Message}"
                                               FontFamily="{StaticResource PixelFont}"
                                               FontSize="9"
                                               Foreground="#8B5A2B"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Actions & Toggle -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Edit"
                                            Padding="10,4"
                                            Margin="0,0,8,0"
                                            Click="BtnEditReminder_Click"
                                            Tag="{Binding}" />

                                    <Button Content="Delete"
                                            Padding="8,4"
                                            Margin="0,0,12,0"
                                            Foreground="#B00020"
                                            Click="BtnDeleteReminder_Click"
                                            Tag="{Binding}" />

                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center"
                                              Checked="ChkEnabled_Changed"
                                              Unchecked="ChkEnabled_Changed"
                                              Tag="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. Promo Card linking to Matches tab -->
        <Border Grid.Row="2"
                Background="#EBF3FA"
                BorderBrush="#004D98"
                BorderThickness="2"
                CornerRadius="4"
                Padding="14,10"
                Cursor="Hand"
                MouseLeftButtonUp="PromoCard_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="⚽🏎️ Want match day &amp; race reminders too?"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#004D98"
                               TextWrapping="Wrap" />
                    <TextBlock Text="FC Barcelona fixtures &amp; F1 race schedules automatically alert your dog companion!"
                               FontSize="11"
                               Foreground="#333333"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="View Matches →"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="9"
                           Foreground="#004D98"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
