<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PixelDogReminders</RootNamespace>
    <AssemblyName>PixelDogReminders</AssemblyName>
    <Product>Pixel Dog Reminders</Product>
    <AssemblyTitle>Pixel Dog Reminders</AssemblyTitle>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;scripts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Sprites\*.png" />
    <Resource Include="Assets\Scenery\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
