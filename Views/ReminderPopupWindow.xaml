<Window x:Class="PixelDogReminders.Views.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixel Dog Reminder"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <!-- Pixel Button Style -->
        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FFF8E7"
                                BorderBrush="#2D1E14"
                                BorderThickness="3"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE4A0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E09040" />
                                <Setter TargetName="border" Property="Margin" Value="0,2,0,-2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pixel Speech Bubble Style -->
        <Style x:Key="SpeechBubbleStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFBF0" />
            <Setter Property="BorderBrush" Value="#2D1E14" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="3" Direction="315" Color="#30000000" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Transform for Slide-in/Slide-out -->
    <Grid x:Name="RootLayout" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTranslateTransform" X="0" Y="0" />
        </Grid.RenderTransform>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">

            <!-- 1. Speech Bubble -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,2">
                <Border Style="{StaticResource SpeechBubbleStyle}" HorizontalAlignment="Center" MaxWidth="260">
                    <StackPanel>
                        <!-- Reminder Title / Name -->
                        <TextBlock x:Name="TxtTitle"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="8"
                                   Foreground="#9E5B23"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,6"
                                   Text="REMINDER" />

                        <!-- Reminder Message -->
                        <TextBlock x:Name="TxtMessage"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="11"
                                   Foreground="#2D1E14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="16"
                                   Text="paani pi le" />
                    </StackPanel>
                </Border>

                <!-- Speech Bubble Tail pointing down to dog -->
                <Polygon Points="0,0 8,10 16,0"
                         Fill="#FFFBF0"
                         Stroke="#2D1E14"
                         StrokeThickness="3"
                         HorizontalAlignment="Center"
                         Margin="0,-2,0,0" />
            </StackPanel>

            <!-- 2. Dog Sprite + Shadow -->
            <Grid HorizontalAlignment="Center" Width="180" Height="170" Margin="0,-4,0,4">
                <!-- Drop Shadow beneath the dog -->
                <Ellipse Width="120" Height="22"
                         Fill="#70000000"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,8">
                    <Ellipse.Effect>
                        <BlurEffect Radius="14" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Dog Sprite Image -->
                <Image x:Name="ImgDogSprite"
                       Width="160"
                       Height="160"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>

            <!-- 3. Pixel Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="BtnSnooze"
                        Content="Snooze"
                        Style="{StaticResource PixelButtonStyle}"
                        Click="BtnSnooze_Click" />

                <Button x:Name="BtnOkii"
                        Content="Okii"
                        Style="{StaticResource PixelButtonStyle}"
                        Background="#D4EDDA"
                        Click="BtnOkii_Click" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
