<Window x:Class="PixelDogReminders.Views.ClassFlagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Reminder Alert"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>
    </Window.Resources>

    <Grid Margin="12">
        <!-- 1. Simple Style (Classic Fly-by Flag) -->
        <Grid x:Name="SimpleContainer">
            <Border x:Name="FlagBorder"
                    Background="#64B5F6"
                    BorderBrush="#2D1E14"
                    BorderThickness="3"
                    CornerRadius="4"
                    Padding="16,10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#2D1E14" Direction="315" ShadowDepth="4" BlurRadius="0" Opacity="0.8" />
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚩" 
                               FontSize="14" 
                               Margin="0,0,10,0" 
                               VerticalAlignment="Center" />

                    <Border x:Name="CountdownBadge"
                            Background="#2D1E14"
                            CornerRadius="3"
                            Padding="6,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCountdown"
                                   Text="in 10 min"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="9"
                                   Foreground="#FFD700"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TxtSubjectName"
                               Text="Data Structures"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#2D1E14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Cloud Style (Floating Pixel Cloud) -->
        <Grid x:Name="CloudContainer" Visibility="Collapsed" Width="360" Height="120">
            <!-- Cloud Graphic Backdrop -->
            <Image Source="pack://application:,,,/Assets/Sprites/reminder_cloud.png"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Image.Effect>
                    <DropShadowEffect Color="#30000000" Direction="315" ShadowDepth="5" BlurRadius="4" />
                </Image.Effect>
            </Image>

            <!-- Text Content inside Cloud -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                <Border Background="#2D1E14"
                        CornerRadius="3"
                        Padding="6,3"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4">
                    <TextBlock x:Name="TxtCloudCountdown"
                               Text="in 10 min"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="8"
                               Foreground="#FFD700" />
                </Border>

                <TextBlock x:Name="TxtCloudSubject"
                           Text="Data Structures"
                           FontFamily="{StaticResource PixelFont}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#2D1E14"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 3. Banner Style (Hanging Billboard / Hoarding) -->
        <Grid x:Name="BannerContainer" Visibility="Collapsed" Width="380">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hanging Suspension Strings attached to top of screen -->
            <Grid x:Name="PnlHangingStrings" Grid.Row="0" VerticalAlignment="Stretch">
                <!-- Left String -->
                <Border Width="3"
                        Background="#3D271D"
                        HorizontalAlignment="Left"
                        Margin="40,0,0,0" />
                <!-- Right String -->
                <Border Width="3"
                        Background="#3D271D"
                        HorizontalAlignment="Right"
                        Margin="0,0,40,0" />
            </Grid>

            <!-- Hanging Billboard Plaque -->
            <Border x:Name="BillboardBorder"
                    Grid.Row="1"
                    Background="#24160E"
                    BorderBrush="#FFD700"
                    BorderThickness="3"
                    CornerRadius="4"
                    Padding="16,12"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#2D1E14" Direction="315" ShadowDepth="5" BlurRadius="0" Opacity="0.8" />
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Top Hooks & Countdown -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="🔔 " FontSize="11" VerticalAlignment="Center" />
                        <Border Background="#3D271D"
                                BorderBrush="#5A3E2B"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBannerCountdown"
                                       Text="in 10 min"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FFD700" />
                        </Border>
                    </StackPanel>

                    <!-- Subject Accent Plate -->
                    <Border x:Name="BannerSubjectPlaque"
                            Background="#64B5F6"
                            CornerRadius="3"
                            Padding="12,6"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtBannerSubject"
                                   Text="Data Structures"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#2D1E14"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
