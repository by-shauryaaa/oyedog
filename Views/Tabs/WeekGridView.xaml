<UserControl x:Class="PixelDogReminders.Views.Tabs.WeekGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Border Background="#FAF7F2"
                BorderBrush="#2D1E14"
                BorderThickness="2"
                CornerRadius="6"
                Margin="4"
                Padding="8">
            <Grid x:Name="GridSchedule" MinWidth="680">
                <!-- Columns and Rows are generated programmatically in code-behind for exact layout -->
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
