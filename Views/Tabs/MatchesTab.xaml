<UserControl x:Class="PixelDogReminders.Views.Tabs.MatchesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="680">

    <UserControl.Resources>
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Press Start 2P</FontFamily>

        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="#2D1E14" />
            <Setter Property="Background" Value="#FFF8E7" />
            <Setter Property="BorderBrush" Value="#8D6E57" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Master Toggle -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#D0C4B8"
                BorderThickness="2"
                CornerRadius="4"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="SPORTS &amp; MATCH REMINDERS"
                               FontFamily="{StaticResource PixelFont}"
                               FontSize="10"
                               Foreground="#3D271D"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Automatic popup notifications when FC Barcelona plays or F1 sessions start."
                               FontSize="11"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <CheckBox x:Name="ChkMasterToggle"
                              Content="Match Reminders Active"
                              FontWeight="Bold"
                              VerticalAlignment="Center"
                              Checked="ChkMasterToggle_Changed"
                              Unchecked="ChkMasterToggle_Changed"
                              Margin="0,4,12,4" />

                    <Button x:Name="BtnRefresh"
                            Content="Refresh"
                            Style="{StaticResource PixelButtonStyle}"
                            Click="BtnRefresh_Click"
                            VerticalAlignment="Center"
                            Margin="0,4,0,4" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Loading / Status indicator -->
        <TextBlock x:Name="TxtStatus"
                   Grid.Row="1"
                   Text="Updating fixtures &amp; race sessions..."
                   FontSize="11"
                   Foreground="#8D6E57"
                   Margin="4,0,0,8"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- Cards Feed -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty placeholder -->
                <Border x:Name="PnlEmptyState"
                        Background="#FFFBF0"
                        BorderBrush="#E0D6CC"
                        BorderThickness="2"
                        CornerRadius="4"
                        Padding="16"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No upcoming sessions found in the next 30 days."
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#5A3E2B"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Note: Add your free Football-Data.org API key in Settings to view Barcelona fixtures."
                                   FontSize="11"
                                   Foreground="#888888"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="ItemsSchedule">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E0D6CC"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Margin="0,0,0,8"
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category color bar on left -->
                                    <Border Background="{Binding CategoryColor}"
                                            CornerRadius="2" />

                                    <!-- Event details -->
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding CategoryColor}"
                                                    CornerRadius="2"
                                                    Padding="6,2"
                                                    Margin="0,0,8,4">
                                                <TextBlock Text="{Binding Category}"
                                                           FontFamily="{StaticResource PixelFont}"
                                                           FontSize="7"
                                                           Foreground="#FFFFFF"
                                                           FontWeight="Bold" />
                                            </Border>

                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Foreground="#7A5C45"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,0,4" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="#2D1E14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Date & Time badge -->
                                    <Border Grid.Column="2"
                                            Background="#F8F4EE"
                                            BorderBrush="#D0C4B8"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6"
                                            MinWidth="90"
                                            VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedDate}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding FormattedTime}"
                                                       FontFamily="{StaticResource PixelFont}"
                                                       FontSize="8"
                                                       Foreground="#8B5A2B"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
